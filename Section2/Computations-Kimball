// A Magma implementation of Kimball Martin's Sage Code: https://kimballmartin.github.io/data/

Kimball_r := function(D,n)
	count := 0;
	for x in [1..2*n] do
		if (x*x-D) mod (4*n) eq 0 then
			count := count + 1;
		end if;
	end for;
	return count;
end function;

// The Class Number computation using Magma simply takes too much time. We recommend using the version below.
Classno := function(D)
	K := QuadraticField(D);
	return ClassNumber(K);
end function;

Hprime := function(D)
	if D eq -4 then
		return 1/2;
	elif D eq -3 then
		return 1/3;
	else
		return Classno(D);
	end if;
end function;

Delta := function(N)
	if N mod 4 eq 3 then
		return -1*N;
	else
		return -4*N;
	end if;
end function;

Kimball_b := function(M1,M2)
	j := M1 mod 8;
	i := M2 mod 2;
	if i eq 1 then
		if j eq 3 then
			return 4;
		elif j eq 7 then
			return 2;
		else
			return 1;
		end if;
	elif j eq 3 then
		return -2;
	elif j eq 7 then
		return 0;
	else
		return -1;
	end if;
end function;

Kimball_c := function(N0,N2)
	if N0 mod 4 ne 3 then
		return 1;
	end if;
	if N2 mod 2 eq 1 then
		return 3 - KroneckerSymbol(N0,2);
	end if;
	if N2 mod 2 eq 0 then
		return 5 - KroneckerSymbol(N0,2);
	end if;
end function;

Kimball_p2 := function(k)
	j := k mod 8;
	if j eq 0 or j eq 6 then
		return -1;
	end if;
	return 1;
end function;

Kimball_p3 := function(k)
	j := k mod 12;
	if j eq 0 or j eq 8 then
		return -1;
	end if;
	if j eq 2 or j eq 6 then
		return 1;
	end if;
	if j eq 4 then
		return 2;
	end if;
	return -2;
end function;

// for squarefree N compute the dimension of the newspace of S_k(N).
Snewdim := function(N,k)
	d := (k-1)*EulerPhi(N)/12;
	c1 := ((1-k)/4+Floor(k/4));
	c2 := ((1-k)/3+Floor(k/3));
	for p in PrimeDivisors(N) do
		c1 := c1*(KroneckerSymbol(-4,p)-1);
		c2 := c2*(KroneckerSymbol(p,3)-1);
	end for;
	d := d + c1 + c2;
	if k eq 2 then
		d := d + MoebiusMu(N);
	end if;
	return d;
end function;

// compute the trace of W_M on S_k(N), assuming M > 1 and N squarefree.
Tr0 := function(N,M,k, classno_data)
	if M eq 1 then
		return Snewdim(N,k);
	end if;
	
	D := Delta(M);
	h := classno_data[D];
	M2 := Floor(N/M);
	M2odd := M2;
	j := 0;
	if M2odd mod 2 eq 0 then
		M2odd := Floor(M2/2);
		j := 1;
	end if;
	pset := PrimeDivisors(M2odd);
	prod1 := 1;
	for p in pset do
		prod1 := prod1 * (KroneckerSymbol(D,p) - 1);
	end for;
	tr := (-1)^(k/2) * prod1 * Kimball_b(M, M2) * h/2;
	w := #PrimeDivisors(M2);
	if M eq 2 then
		prod2 := 1;
		for p in pset do
			prod2 := prod2 * (KroneckerSymbol(-4,p)-1);
		end for;
		tr := tr - (-1)^j * Kimball_p2(k) * prod2/2;
	end if;
	if M eq 3 then
		tr := tr/3 - (-1)^j*(j+1)/3 * Kimball_p3(k) * prod1;
	end if;
	if k eq 2 then
		tr := tr + (-1)^w;
	end if;
	return tr;
end function;

// sign pattern of length w corresponding to n
Signpat := function(w,n)
	pat := [];
	for j in [1..w] do
		pat := pat cat [2*Floor(BitwiseAnd(n,2^j)/2^j)-1];
	end for;
	return pat;
end function;

Signpatint := function(eps)
	n := 0;
	for j in [1..#eps] do
		n := n + 2^j*Floor((eps[j]+1)/2);
	end for;
	return n;
end function;

Allsignpats := function(N)
	w := #PrimeDivisors(N);
	l := [];
	for i in [1..2^w] do
		l := l cat [Signpat(w,i)];
	end for;
	return l;
end function;

Signpateval := function(chi,N,d)
	P := PrimeDivisors(N);
	P := Sort(P);
	prod := 1;
	chidict := [];
	for i in [1..#P] do
		chidict := chidict cat [[P[i],chi[i]]];
	end for;
	for p in PrimeDivisors(d) do
		for i in [1..#P] do
			if P[i] eq p then
				prod := prod * chi[i];
				break;
			end if;
		end for;
	end for;
	return prod;
end function;

//For squarefree N compute dimension of AL newspace with given sign pattern. Input sign pattern as number i between 0 and 2^w(N)-1.
Refdim := function(N,i,k,classno_data)
	s := 0;
	w := #PrimeDivisors(N);
	chi := Signpat(w,i);
	for d in Divisors(N) do
		s := s + Signpateval(chi,N,d) * Tr0(N,d,k,classno_data);
	end for;
	return Floor(s/(2^w));
end function;
