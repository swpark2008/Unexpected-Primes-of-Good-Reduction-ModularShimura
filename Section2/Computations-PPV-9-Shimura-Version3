load "Computations-Shimura-Basic";

// module for creating all possible sign patterns
sign_list := [[a1,a2,a3,a4,a5,a6,a7,a8,a9] : a1,a2,a3,a4,a5,a6,a7,a8,a9 in {-1,1}];

// module for generating the desired set of prime factors
b9 := 505520992240;

B9 := [];
for i in [1..#sign_list] do
	B9 := B9 cat [[sign_list[i]]];
end for;
print(B9);

bp1 := FloorBound(b9,1,9);
for p1 in [2,3] do
    	bp2 := FloorBound(b9,p1,8);
    	if bp2 lt p1+1 then
        	break;
    	end if;
	for p2 in PrimesInInterval(p1+1,bp2) do
		bp3 := FloorBound(b9,p1*p2,7);
		if bp3 lt p2+1 then
				break;
		end if;
		for p3 in PrimesInInterval(p2+1,bp3) do
			bp4 := FloorBound(b9,p1*p2*p3,6);
			if bp4 lt p3+1 then
				break;
			end if;
			for p4 in PrimesInInterval(p3+1,bp4) do
				bp5 := FloorBound(b9,p1*p2*p3*p4,5);
				if bp5 lt p4+1 then
					break;
				end if;
				for p5 in PrimesInInterval(p4+1,bp5) do
					bp6 := FloorBound(b9,p1*p2*p3*p4*p5,4);
					if bp6 lt p5+1 then
						break;
					end if;
					for p6 in PrimesInInterval(p5+1,bp6) do
						bp7 := FloorBound(b9,p1*p2*p3*p4*p5*p6,3);
						if bp7 lt p6+1 then
							break;
						end if;
						for p7 in PrimesInInterval(p6+1,bp7) do
							bp8 := FloorBound(b9,p1*p2*p3*p4*p5*p6*p7,2);
							if bp8 lt p7+1 then
								break;
							end if;
							for p8 in PrimesInInterval(p7+1,bp8) do
								B9_sub := [];
								bp9 := FloorBound(b9,p1*p2*p3*p4*p5*p6*p7*p8,1);
								if bp9 lt p8+1 then
									break;
								end if;
								for p9 in PrimesInInterval(p8+1,bp9) do
									N := p1*p2*p3*p4*p5*p6*p7*p8*p9;
									if N le b9 then
										prime_list_test := [p1,p2,p3,p4,p5,p6,p7,p8,p9];
										print(prime_list_test);
										for i in [1] do
											sign_pattern := sign_list[i];
											if NaiveSieve_pre(prime_list_test, p1, sign_pattern) then
												B9_sub := B9_sub cat [prime_list_test];
											end if;
										end for;
									end if;
								end for;
								
								print("Legendre Sieve");
								print(#B9_sub);
								for prime_list_test in B9_sub do
									print(prime_list_test);
									for i in [1..#sign_list] do
										sign_pattern := sign_list[i];
										if NaiveSieve_two(prime_list_test, p1, sign_pattern) then
											B9[i] := B9[i] cat [prime_list_test];
										end if;
									end for;
								end for;
							end for;
						end for;
					end for;
				end for;
			end for;
		end for;
	end for;
end for;

for i in [1..#sign_list] do
	title := "Shimura-9-Results" cat IntegerToString(i);
	if #B9[i] ge 2 then
		Write(title,B9[i]: Overwrite := true);
	end if;
end for;
