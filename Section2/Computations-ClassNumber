load "Computations-Kimball";

// Parsing function for LMFDB database (optional)
ClassNumberReader := function(data_name, value)
	param_list := Split(data_name,"_");
	param := StringToInteger(param_list[4]);
	lower_bound := -1*StringToInteger(param_list[5])*2^(28)-StringToInteger(param_list[2]);
	print([param,lower_bound]);
	
	sub_data := Split(Read(data_name),"\n");
	for i in [1..#sub_data] do
		parse_string := Split(sub_data[i],"\t");
		lower_bound := lower_bound - StringToInteger(parse_string[1])*param;
		if Abs(lower_bound) eq value then
			return StringToInteger(parse_string[2]);
		end if;
	end for;
end function;

// Parsing function for LMFDB database that combines small class numbers. Suitable for omega = 2,3,4,5,6
ClassNumberCompiler_small := function()
	SetNthreads(64);
	data_name_list := ["cl_3_mod_8_0","cl_4_mod_16_0","cl_7_mod_8_0","cl_8_mod_16_0"];
	class_data := AssociativeArray();
	for data_name in data_name_list do
		print(data_name);
		param_list := Split(data_name,"_");
		param := StringToInteger(param_list[4]);
		lower_bound := -1*StringToInteger(param_list[5])*2^(28)-StringToInteger(param_list[2]);
		sub_data := Split(Read(data_name),"\n");
		for i in [1..#sub_data] do
			parse_string := Split(sub_data[i],"\t");
			lower_bound := lower_bound - StringToInteger(parse_string[1])*param;
			class_data[lower_bound] := StringToInteger(parse_string[2]);
		end for;
	end for;
	return class_data;
end function;

