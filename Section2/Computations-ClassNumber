// Construct database of class numbers from "Shimura-M-ResultsXXX" for M=7,8 files obtained as output of Computations-PPV-Shimura
ClassnoFromDatabase := function(omega)
	output := AssociativeArray();
	divisors_database := {@ @};
	SetNthreads(64);
	// Combine all divisors occuring in "Shimura-X-ResultsXXX" files.
	for index in [omega] do
		file_name := "Shimura-";
		file_name := file_name cat IntegerToString(index);
		file_name := file_name cat "-Results";
		for m in [1..2^(index)] do
			sub_output := [];
			sub_file_name := file_name cat IntegerToString(m);
			sub_file := Read(sub_file_name);
			sub_file := Split(sub_file,"\n");
			sign_pattern := Split(sub_file[2],"[], ");
			sign_pattern := [StringToInteger(s) : s in sign_pattern];
			print(sign_pattern);
			for lines in [3..#sub_file-1] do
				new_line := Split(sub_file[lines],"[], ");
				line_int := 1;
				for factors in new_line do
					line_int := line_int * StringToInteger(factors);
				end for;
				divisor_line := IndexedSet(Divisors(line_int));
				divisors_database := divisors_database join divisor_line;
			end for;
		end for;
	end for;
	
	for m in [1..#divisors_database] do
		M_class := Delta(divisors_database[m]);
		classno_m := Classno(M_class);
		output[M_class] := classno_m;
		if m mod 100 eq 0 then
			print(m);
		end if;
	end for;
	
	return output;
end function;

Fundamental_Disc := function(level)
	level := -1*level;
	if level mod 4 eq 1 then
		return level;
	else
		return 4*level;
	end if;
end function;

// Reading Outputs of form "Shimura-M-ResultsXXX" files for M=2,3,4,5,6 obtained as output of Computations-PPV-Shimura
EigenspaceFromDatabase := function(omega, classno_data)
	output := [];
	for index in [omega] do
		file_name := "Shimura-";
		file_name := file_name cat IntegerToString(index);
		file_name := file_name cat "-Results";
		for m in [1..2^(index)] do
			sub_output := [];
			sub_file_name := file_name cat IntegerToString(m);
			sub_file := Read(sub_file_name);
			sub_file := Split(sub_file,"\n");
			sign_pattern := Split(sub_file[2],"[], ");
			sign_pattern := [StringToInteger(s) : s in sign_pattern];
			print(sign_pattern);
			for lines in [3..#sub_file-1] do
				new_line := Split(sub_file[lines],"[], ");
				line_int := 1;
				for factors in new_line do
					line_int := line_int * StringToInteger(factors);
				end for;
				dim := Refdim(line_int, Signpatint(sign_pattern), 2, classno_data);
				if dim eq 0 then
					print(line_int);
					sub_output := sub_output cat [line_int];
				end if;
			end for;
			output_pre := [sign_pattern] cat [sub_output];
			if #sub_output ne 0 then
				output := output cat output_pre;
			end if;
		end for;
	end for;
	return output;
end function;

