// module for sieve result on sieving out list of prime factors before applying NaiveSieve_two. We evaluate \sum sqrt{d} 2^(omega(N/d)) log(d) directly.
NaiveSieve_pre := function(prime_list_test,p1)
	omega := #prime_list_test;
	pset := {p : p in prime_list_test};
	N := &*prime_list_test;
	varphi_N := &*[p-1 : p in prime_list_test];
	if p1 eq 3 then
		R := 1/12*varphi_N - 29/12*2^omega - 2;
	elif p1 eq 2 then
		R := 1/12*varphi_N - 59/12*2^omega - 3;
	else
		R := 1/12*varphi_N - 19/12*2^omega - 1;
	end if;
		
	naive_value := 0;
	for x in Subsets(pset) do
		NoverD := &*x;
		omega_NoverD := #x;
		D := Floor(N/(NoverD));
		naive_value := naive_value + Ceiling(Sqrt(D)*2^(omega_NoverD)*Log(D));
	end for;
		
	R := R - naive_value;
	if R lt 0 then
		return true;
	else
		return false;
	end if;
end function;
