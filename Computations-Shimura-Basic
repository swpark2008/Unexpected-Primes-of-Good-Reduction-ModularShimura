// function for obtaining bounds for forloops used to iterate prime factors

FloorBound := function(B,prod,k) 
	return Floor((B/prod)^(1/k));
end function;

// Candidate pairs for (D,N) given a list of divisors for DN
Admissible := function(F,n)
	sets := Permutations(SequenceToSet(F),n); 
	result := [];
	for s in sets do
		sort := Sort(s);
		if sort in result eq false then
			result := result cat [sort];
		end if;
	end for;
	return result;
end function;

Complement := function(F,FF)
	return [i : i in F | i in FF eq false];
end function;


//n is omega(DN)


AdmissibleSum := function(n)
	return [[2*i,n-2*i] : i in [1..Floor(n/2)]];
end function;

//n is omega(DN)

//n := ...;

CandidatePairs := function(F)
	result := [];
	n := #F;
	for sum in AdmissibleSum(n) do
		n1 := sum[1]; n2 := sum[2];
		if n1 lt n2 then
			result := result cat [[set,Complement(F,set)] : set in Admissible(F,n1)];
			else result := result cat [[Complement(F,set),set] : set in Admissible(F,n2)];
		end if;
	end for;
	return result;
end function;

// [F1,F2] in CandidatePairs(F)
SignPattern := function(F,F1,F2)
	result := [];
	for p in F do
		if p in F1 then 
			result := result cat [-1];
			else result := result cat [1];
		end if;
	end for;
	return result;
end function;

// module for first sieve result on applying conditions for S. The only place to change is the set B* for the definition of omega and for loop statement for prime_list. Required input is the nested list of list of prime factors (B*) & p1 (the smallest possible prime number).

evaluate_sign := function(number_fact, large_number_fact, pattern);
	LNF := Sort(SetToSequence(large_number_fact));
	NF := Sort(SetToSequence(number_fact));
	new_pattern := [];

	for i in [1..#LNF] do
		new_pattern := new_pattern cat [[LNF[i], pattern[i]]];
	end for;

	sign_result := 1;

	for i in [1..#new_pattern] do
		if new_pattern[i][1] in NF then
			sign_result := sign_result * new_pattern[i][2];
		end if;
	end for;
	
	if sign_result eq 1 then
		return 0;
	else
		return 1;
	end if;
end function;

NaiveSieve_two := function(B_list,p1)
	B_sub := [];
	omega := #B_list[1];
	for prime_list in B_list do
		pset := {p : p in prime_list};
		N := &*prime_list;
		varphi_N := &*[p-1 : p in prime_list];
		if p1 eq 3 then
			R := 1/12*varphi_N - 29/12*2^omega - 2;
		elif p1 eq 2 then
			R := 1/12*varphi_N - 59/12*2^omega - 3;
		else
			R := 1/12*varphi_N - 19/12*2^omega - 1;
		end if;
		
		// new candidate generating prime factors of N and D given a single prime_list giving ND
		ND_list := CandidatePairs(prime_list);
		ND_SignPattern := [];
		for ND_candidate in ND_list do
			ND_SignPattern := ND_SignPattern cat [SignPattern(prime_list, ND_candidate[1], ND_candidate[2])];
		end for;
		for sign_pattern in ND_SignPattern do
			for x in Subsets(pset) do
				NoverD := &*x;
				D := Floor(N/(NoverD));
				D_factors := {num : num in pset | num notin x};
				sign := evaluate_sign(D_factors, pset, sign_pattern);
				sign_param := #x + sign;
				if #x ne 0 and p1 ne 2 and sign_param mod 2 eq 0 then
					s := 0;
					for q in x do
						if D mod 4 eq 1 and q ne 2 then
							if LegendreSymbol(4*D,q) eq 1 then
								s := 1;
								break;
							end if;
						end if;
						if D mod 4 ne 1 and q ne 2 then
							if LegendreSymbol(D,q) eq 1 then
								s := 1;
								break;
							end if;
						end if;
					end for;
					if s eq 0 then
						R := R - 2/(3.14)*N^(1/2)*Log(D);
					end if;
				end if;
				if #x ne 0 and p1 eq 2 and NoverD mod 2 eq 0 and sign_param mod 2 eq 1 then
					s := 0;
					for q in x do
						if D mod 4 eq 1 and q ne 2 then
							if LegendreSymbol(4*D,q) eq 1 then
								s := 1;
								break;
							end if;
						end if;
						if D mod 4 ne 1 and q ne 2 then
							if LegendreSymbol(D,q) eq 1 then
								s := 1;
								break;
							end if;
						end if;
					end for;
					if s eq 0 then
						R := R - 1/(3.14)*N^(1/2)*Log(D);
					end if;
				end if;
				if #x ne 0 and p1 eq 2 and NoverD mod 2 eq 1 and sign_param mod 2 eq 0 then
					s := 0;
					for q in x do
						if D mod 4 eq 1 and q ne 2 then
							if LegendreSymbol(4*D,q) eq 1 then
								s := 1;
								break;
							end if;
						end if;
						if D mod 4 ne 1 and q ne 2 then
							if LegendreSymbol(D,q) eq 1 then
								s := 1;
								break;
							end if;
						end if;
					end for;
					if s eq 0 then
						R := R - 2/(3.14)*N^(1/2)*Log(D);
					end if;
				end if;
			end for;
			if R lt 0 then
				print(prime_list);
				B_sub := B_sub cat [[prime_list, sign_pattern]];
			end if;
		end for;
	end for;
	return B_sub;
end function;

