load "Computations-Shimura-Basic";

// module for creating all possible sign patterns
sign_list := [[a1,a2,a3,a4,a5] : a1,a2,a3,a4,a5 in {-1,1}];

// module for generating the desired set of prime factors
b5 := 745913629;

B5 := [];
for i in [1..#sign_list] do
	B5 := B5 cat [[sign_list[i]]];
end for;
print(B5);

bp1 := FloorBound(b5,1,5);
for p1 in PrimesInInterval(2,bp1) do
    	bp2 := FloorBound(b5,p1,4);
    	if bp2 lt p1+1 then
        	break;
    	end if;
	for p2 in PrimesInInterval(p1+1,bp2) do
		bp3 := FloorBound(b5,p1*p2,3);
		if bp3 lt p2+1 then
				break;
		end if;
		for p3 in PrimesInInterval(p2+1,bp3) do
			bp4 := FloorBound(b5,p1*p2*p3,2);
			if bp4 lt p3+1 then
				break;
			end if;
			for p4 in PrimesInInterval(p3+1,bp4) do
				B5_sub := [];
				bp5 := FloorBound(b5,p1*p2*p3*p4,1);
				if bp5 lt p4+1 then
					break;
				end if;
				for p5 in PrimesInInterval(p4+1,bp5) do
					N := p1*p2*p3*p4*p5;
					if N le b5 then
						prime_list_test := [p1,p2,p3,p4,p5];
						print(prime_list_test);
						for i in [1] do
							sign_pattern := sign_list[i];
							if NaiveSieve_pre(prime_list_test, p1, sign_pattern) then
								B5_sub := B5_sub cat [prime_list_test];
							end if;
						end for;
					end if;
				end for;
				
				print("Legendre Sieve");
				print(#B5_sub);
				for prime_list_test in B5_sub do
					print(prime_list_test);
					for i in [1..#sign_list] do
						sign_pattern := sign_list[i];
						if NaiveSieve_two(prime_list_test, p1, sign_pattern) then
							B5[i] := B5[i] cat [prime_list_test];
						end if;
					end for;
				end for;
			end for;
		end for;
	end for;
end for;

for i in [1..#sign_list] do
	title := "Shimura-5-Results" cat IntegerToString(i);
	if #B5[i] ge 1 then
		print("Output prepared");
		Write(title,B5[i]: Overwrite := true);
	end if;
end for;
