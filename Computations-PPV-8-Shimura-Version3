load "Computations-Shimura-Basic";

// module for creating all possible sign patterns
sign_list := [[a1,a2,a3,a4,a5,a6,a7,a8] : a1,a2,a3,a4,a5,a6,a7,a8 in {-1,1}];

// module for generating the desired set of prime factors
b8 := 82721212694;

B8 := [];
for i in [1..#sign_list] do
	B8 := B8 cat [[sign_list[i]]];
end for;
print(B8);

bp1 := FloorBound(b8,1,8);
for p1 in PrimesInInterval(2,bp1) do
    	bp2 := FloorBound(b8,p1,7);
    	if bp2 lt p1+1 then
        	break;
    	end if;
	for p2 in PrimesInInterval(p1+1,bp2) do
		bp3 := FloorBound(b8,p1*p2,6);
		if bp3 lt p2+1 then
				break;
		end if;
		for p3 in PrimesInInterval(p2+1,bp3) do
			bp4 := FloorBound(b8,p1*p2*p3,5);
			if bp4 lt p3+1 then
				break;
			end if;
			for p4 in PrimesInInterval(p3+1,bp4) do
				bp5 := FloorBound(b8,p1*p2*p3*p4,4);
				if bp5 lt p4+1 then
					break;
				end if;
				for p5 in PrimesInInterval(p4+1,bp5) do
					bp6 := FloorBound(b8,p1*p2*p3*p4*p5,3);
					if bp6 lt p5+1 then
						break;
					end if;
					for p6 in PrimesInInterval(p5+1,bp6) do
						bp7 := FloorBound(b8,p1*p2*p3*p4*p5*p6,2);
						if bp7 lt p6+1 then
							break;
						end if;
						for p7 in PrimesInInterval(p6+1,bp7) do
							B8_sub := [];
							bp8 := FloorBound(b8,p1*p2*p3*p4*p5*p6*p7,1);
							if bp8 lt p7+1 then
								break;
							end if;
							for p8 in PrimesInInterval(p7+1,bp8) do
								N := p1*p2*p3*p4*p5*p6*p7*p8;
								if N le b8 then
									prime_list_test := [p1,p2,p3,p4,p5,p6,p7,p8];
									if NaiveSieve_pre(prime_list_test,p1) then
										print(prime_list_test);
										B8_sub := B8_sub cat [prime_list_test];
									else
										break;
									end if;
								end if;
							end for;
							
						//Apply naive Sieve
				
							for i in [1..#sign_list] do
								sign_pattern := sign_list[i];
								print(sign_pattern);
								if #B8_sub ge 1 then
									B_sieve := NaiveSieve_two_sign(B8_sub,p1,sign_pattern);
									B8[i] := B8[i] cat B_sieve;
								end if;
							end for;
						end for;
					end for;
				end for;
			end for;
		end for;
	end for;
end for;

for i in [1..#sign_list] do
	title := "Shimura-8-Results" cat IntegerToString(i);
	if #B8[i] ge 2 then
		Write(title,B8[i]: Overwrite := true);
	end if;
end for;
