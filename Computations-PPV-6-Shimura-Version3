load "Computations-Shimura-Basic";

// module for creating all possible sign patterns
sign_list := [[a1,a2,a3,a4,a5,a6] : a1,a2,a3,a4,a5,a6 in {-1,1}];

// module for generating the desired set of prime factors
b6 := 3107245686;

B6 := [];
for i in [1..#sign_list] do
	B6 := B6 cat [[sign_list[i]]];
end for;
print(B6);

bp1 := FloorBound(b6,1,6);
for p1 in PrimesInInterval(2,bp1) do
    	bp2 := FloorBound(b6,p1,5);
    	if bp2 lt p1+1 then
        	break;
    	end if;
	for p2 in PrimesInInterval(p1+1,bp2) do
		bp3 := FloorBound(b6,p1*p2,4);
		if bp3 lt p2+1 then
				break;
		end if;
		for p3 in PrimesInInterval(p2+1,bp3) do
			bp4 := FloorBound(b6,p1*p2*p3,3);
			if bp4 lt p3+1 then
				break;
			end if;
			for p4 in PrimesInInterval(p3+1,bp4) do
				bp5 := FloorBound(b6,p1*p2*p3*p4,2);
				if bp5 lt p4+1 then
					break;
				end if;
				for p5 in PrimesInInterval(p4+1,bp5) do
					B6_sub := [];
					bp6 := FloorBound(b6,p1*p2*p3*p4*p5,1);
					if bp6 lt p5+1 then
						break;
					end if;
					for p6 in PrimesInInterval(p5+1,bp6) do
						N := p1*p2*p3*p4*p5*p6;
						if N le b6 then
							prime_list_test := [p1,p2,p3,p4,p5,p6];
							if NaiveSieve_pre(prime_list_test,p1) then
								print(prime_list_test);
								B6_sub := B6_sub cat [prime_list_test];
							else
								break;
							end if;
						end if;
					end for;
							
				//Apply naive Sieve
		
					for i in [1..#sign_list] do
						sign_pattern := sign_list[i];
						print(sign_pattern);
						if #B6_sub ge 1 then
							B_sieve := NaiveSieve_two_sign(B6_sub,p1,sign_pattern);
							B6[i] := B6[i] cat B_sieve;
						end if;
					end for;
				end for;
			end for;
		end for;
	end for;
end for;

for i in [1..#sign_list] do
	title := "Shimura-6-Results" cat IntegerToString(i);
	if #B6[i] ge 2 then
		Write(title,B6[i]: Overwrite := true);
	end if;
end for;
